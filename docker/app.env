JENA_SECURITY_CREATE: true
JENA_SECURITY_USERNAME: admin_user
JENA_SECURITY_PASSWORD: admin_password

JENA_JIRA_URL: jira.atlassian.com
JENA_JIRA_DEPLOYMENT_TYPE: server
JENA_JIRA_INITIAL_UPDATED_AFTER: 2027-01-01T00:00:00

JENA_JIRA_POLL_CONCURRENCY: 5

JENA_JIRA_SCHEDULE_ENABLED: true
JENA_JIRA_SCHEDULE_CRON: "*/30 * * * * *"
