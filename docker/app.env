JENA_JIRA_SNAPSHOT_SCHEDULER_POOL_SIZE: 10

JENA_JIRA_FORMATTER_DATE_PATTERN: "dd-MM-yyyy"
JENA_JIRA_FORMATTER_DATETIME_PATTERN: "dd-MM-yyyy HH:mm:SSS"
JENA_JIRA_NAMES_FIX_VERSIONS: "Fix Version"
JENA_JIRA_NAMES_VERSIONS: "Version"
JENA_JIRA_NAMES_COMPONENTS: "Component"

JENA_NOTIFICATION_SCHEDULE_CRON: "*/30 * * * * *"
JENA_NOTIFICATION_SCHEDULE_ZONE: Europe/Paris

JENA_NOTIFICATION_TELEGRAM_TOKEN: 123456789:XYZABCDEFGHIJKLMNOPQRSTUVWXYZ
