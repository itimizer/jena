JENA_NOTIFICATION_TELEGRAM_REMOVE_JIRA_FORMATTING: true

JENA_NOTIFICATION_EXPRESS_URL:
JENA_NOTIFICATION_EXPRESS_BOT_ID:
JENA_NOTIFICATION_EXPRESS_SECRET_KEY:

JENA_RETRYER_ENABLED: true
JENA_RETRYER_CRON: "0 * * * * *"
JENA_RETRYER_ZONE: Europe/Paris
JENA_RETRYER_ATTEMPT: 3

JENA_TLS_CACERT: "file:/app/cacert.crt"

